# Copy to .env.local for local development. NEVER commit real values.
# On Vercel these are set in the project's Environment Variables (Production and Preview).

# Postgres connection string (the Neon integration on Vercel adds this one by itself).
DATABASE_URL=

# The password that unlocks writing (adding recipes). Server-side only, never prefix it with NEXT_PUBLIC_.
RECIPE_ADMIN_PASSWORD=

# Signs the session cookie. At least 32 random characters, e.g. the output of: openssl rand -base64 48
# Changing it logs everybody out.
RECIPE_SESSION_SECRET=

# Salt for hashing client IPs in the login rate limit. At least 16 random characters, e.g.: openssl rand -base64 24
RECIPE_IP_SALT=
